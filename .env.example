NODE_ENV=development
PORT=3000
APP_API_PREFIX=api/v1

DB_HOST=localhost
DB_PORT=5432
DB_USER=merchant
DB_PASSWORD=merchant_dev
DB_NAME=merchant_db
DB_DIALECT=postgres
POSTGRES_USER=merchant
POSTGRES_PASSWORD=merchant_dev
POSTGRES_DB=merchant_db
DB_SSL=false

REDIS_URL=redis://localhost:6379

JWT_SECRET=changeme-replace-with-a-long-random-secret-in-production
JWT_EXPIRES_IN=1h

BCRYPT_ROUNDS=12

RISK_JOB_MAX_ATTEMPTS=3
KYB_SIMULATION_MODE=random
KYB_SIMULATION_DELAY_MS=500

